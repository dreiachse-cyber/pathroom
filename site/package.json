{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 tests/catalog.test.mjs tests/catalog-integrity.test.mjs tests/svg-integrity.test.mjs tests/public-assets.test.mjs tests/app-contract.test.mjs tests/icon-visual-qa.test.mjs",
    "qa:icons": "node scripts/generate-icon-visual-qa.mjs --batch 004 --expected-new 32 --expected-baseline 208",
    "test:pages-base": "node scripts/verify-pages-build.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@tabler/icons-react": "3.46.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "2.6.2"
  }
}
